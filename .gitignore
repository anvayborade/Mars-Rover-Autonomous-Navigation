# ==============================================
# Clean Mars rover personal repository
# Root directories: Python/ and Unity/
# ==============================================

# Ignore ALL old ZIP archives except one explicitly selected SB3 checkpoint.
# The specific best_model.zip file is Git LFS tracked (see .gitattributes).
*.zip
*.7z
*.rar

# Old patch notes and scratch files (curated README is at root)
*PATCH*.md
*patch*.md
*PATCH*.txt
*patch*.txt
PHASE2_*.md
README_V15*.txt
README_BENCHMARK.txt

# Python
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/
**/*.egg-info/
Python/archive/
Python/logs/
Python/runs/
# Suppress all other checkpoint trees, but allow the single best model
Python/checkpoints/*
!Python/checkpoints/sac_v15f/
Python/checkpoints/sac_v15f/*
!Python/checkpoints/sac_v15f/seed_71/
Python/checkpoints/sac_v15f/seed_71/*
!Python/checkpoints/sac_v15f/seed_71/best/
Python/checkpoints/sac_v15f/seed_71/best/*
!Python/checkpoints/sac_v15f/seed_71/best/best_model.zip
**/.env
**/.env.*
!**/.env.example

# Unity autogenerated: NEVER ignore real Assets, Packages, ProjectSettings
Unity/[Ll]ibrary/
Unity/[Tt]emp/
Unity/[Oo]bj/
Unity/[Ll]ogs/
Unity/[Uu]ser[Ss]ettings/
Unity/[Bb]uild/
Unity/[Bb]uilds/
Unity/[Mm]emory[Cc]aptures/
Unity/[Rr]ecordings/
Unity/.vs/
Unity/.gradle/
Unity/ExportedObj/
Unity/*.csproj
Unity/*.unityproj
Unity/*.sln
Unity/*.slnx
Unity/*.suo
Unity/*.user
Unity/*.userprefs

# Logs and OS files
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
Desktop.ini

# NEVER use "*.meta" here: Unity .meta files are required!
